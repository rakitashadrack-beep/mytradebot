# ── MyTradeBot Licensing API — Environment Variables ──────────────────────────
# Template only. Never commit a real .env file or paste production values here.
# Replace placeholders in your private deployment settings.

# "production" enforces PostgreSQL, strong secrets, and production providers.
# Use "development" locally with SQLite and manual payments.
MYTRADEBOT_ENV=production

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Three DIFFERENT secrets, each at least 32 random characters.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# The local `python main.py` launcher generates ephemeral distinct development secrets
# when these are unset; production must always set its own persistent values.
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
LICENSE_SIGNING_SECRET=replace-with-a-different-long-random-secret-min-32-chars
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-third-long-random-secret-min-32-chars

# Configure privately; only this address can claim admin.
ADMIN_EMAIL=admin@example.com

# Optional developer/testing account email; configure the intended address privately.
DEVELOPER_EMAIL=developer@example.com

# Trading Economics economic calendar API key; keep private and never commit it.
TRADING_ECONOMICS_API_KEY=

# API rate limit per IP per minute.
RATE_LIMIT_PER_MINUTE=60

# Phone sign-in. Production requires Africa's Talking credentials.
SMS_PROVIDER=africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# CORS: comma-separated exact origins only. Wildcards are rejected in production.
ALLOWED_ORIGINS=https://yourdomain.com

# ── Payment provider ──────────────────────────────────────────────────────────
PAYMENT_PROVIDER=mpesa_daraja
PAID_PLANS_ENABLED=false
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_PRICE_PRO_KES=
MPESA_PRICE_ULTIMATE_KES=
MPESA_PRICE_PLATINUM_KES=
# Use a random URL-safe token of at least 32 characters, and include this exact
# token as the final path segment of MPESA_CALLBACK_URL.
MPESA_CALLBACK_TOKEN=replace-with-a-random-url-safe-token-of-at-least-32-chars
MPESA_CALLBACK_URL=https://yourdomain.com/payments/mpesa/replace-with-a-random-url-safe-token-of-at-least-32-chars
