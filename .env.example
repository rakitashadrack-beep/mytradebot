# ── MyTradeBot Licensing API — Environment Variables ──────────────────────────
# Production deployment template. On Vercel, set these in Project Settings
# → Environment Variables. For local development, use development-only values.
# Never commit a real .env file.

# "production" enforces PostgreSQL, strong secrets, and a real payment provider.
# Use "development" locally with SQLite and manual payments.
MYTRADEBOT_ENV=production

# PostgreSQL connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL=postgresql://mytradebot:replace-me@your-postgres-host:5432/mytradebot

# Two DIFFERENT secrets, each at least 32 random characters.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
LICENSE_SIGNING_SECRET=replace-with-a-different-long-random-secret-min-32-chars

# A third unique secret used once when registering the first administrator.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-third-long-random-secret-min-32-chars

# Only this email can claim the first administrator account.
ADMIN_EMAIL=owner@yourdomain.com

# API rate limit per IP per minute.
RATE_LIMIT_PER_MINUTE=60

# CORS: comma-separated list of allowed origins, or * for any.
# Set to your exact domain(s) in production, e.g.:
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# ── Payment provider ──────────────────────────────────────────────────────────
# Choose: stripe | mobile_money | manual (manual = dev only, no real payments)
PAYMENT_PROVIDER=stripe

# Stripe (required when PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_SUCCESS_URL=https://yourdomain.com/payment-success
PAYMENT_CANCEL_URL=https://yourdomain.com/payment-cancel

# Mobile money adapter (required when PAYMENT_PROVIDER=mobile_money)
MOBILE_MONEY_CHECKOUT_URL=
MOBILE_MONEY_CALLBACK_SECRET=
